    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@12.9.1"
